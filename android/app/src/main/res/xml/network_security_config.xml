<?xml version="1.0" encoding="utf-8"?>
<!-- Only encrypted connections, and only the system's trusted certificate authorities (no user-installed ones). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
